<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions (each is asked for only when the feature is first used) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GPS position, only while the app is in use; a visible notification keeps it
         running with the screen off during trip recording / navigation / anchor alarm.
         ACCESS_BACKGROUND_LOCATION ("allow all the time") is NOT requested. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Microphone, only while the Ask Bahrna button is held or tapped -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Keep the screen on while navigating -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Reminders use inexact timing; exact alarms are not needed (Play policy) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <!-- Works on devices without GPS hardware too (e.g. Wi-Fi tablets), with less accuracy -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false"
        tools:replace="android:required"
    />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
